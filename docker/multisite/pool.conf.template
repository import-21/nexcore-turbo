; Site pool generated by add-site.sh. "ondemand": an idle site uses no worker
; at all; with the nginx page cache in front, most sites stay idle.
[__SITE__]
user = www-data
group = www-data
listen = /run/php/__SITE__.sock
listen.mode = 0666
pm = ondemand
pm.max_children = __CHILDREN__
pm.process_idle_timeout = 2s
pm.max_requests = 500
; Requests slower than this are logged with a PHP backtrace (docker compose logs php).
request_slowlog_timeout = 5s
slowlog = /proc/self/fd/2
env[TURBO_SITE] = __SITE__
php_admin_value[open_basedir] = /srv/sites/__SITE__:/srv/core:/tmp
php_admin_value[upload_tmp_dir] = /tmp
php_admin_value[session.save_path] = /tmp
php_admin_value[disable_functions] = exec,passthru,shell_exec,system,proc_open,popen,pcntl_exec
