; Site pool generated by add-site.sh. "ondemand": an idle site uses no worker
; at all; with the nginx page cache in front, most sites stay idle.
; Every site runs as its own uid (__UID__, no passwd entry needed): another site's PHP can't
; read its files, signal its workers or connect to its socket, even if open_basedir is bypassed.
[__SITE__]
user = __UID__
group = __UID__
listen = /run/php/__SITE__.sock
listen.owner = __UID__
listen.group = 101
listen.mode = 0660
pm = ondemand
pm.max_children = __CHILDREN__
pm.process_idle_timeout = 2s
pm.max_requests = 500
; Requests slower than this are logged with a PHP backtrace (docker compose logs php).
request_slowlog_timeout = 5s
slowlog = /proc/self/fd/2
env[TURBO_SITE] = __SITE__
env[TMPDIR] = /srv/sites/__SITE__/.turbo-tmp
; Temp files and sessions stay in the site's own private dir, never the shared /tmp.
php_admin_value[open_basedir] = /srv/sites/__SITE__:/srv/core
php_admin_value[upload_tmp_dir] = /srv/sites/__SITE__/.turbo-tmp
php_admin_value[session.save_path] = /srv/sites/__SITE__/.turbo-tmp
php_admin_value[sys_temp_dir] = /srv/sites/__SITE__/.turbo-tmp
php_admin_value[disable_functions] = exec,passthru,shell_exec,system,proc_open,popen,pcntl_exec
